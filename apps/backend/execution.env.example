# Copy to .env in apps/backend. Node 22.20+ is required.
PORT=4001
EXECUTION_ENABLED=false
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4001
# Wildcard child hosts are used: <workspace-id>.localhost:4002.
# Production: https://preview.example.com with *.preview.example.com DNS/TLS.
PREVIEW_ORIGIN=http://localhost:4002
PREVIEW_PORT=4002
DATABASE_PATH=./data/heisenbug.sqlite
E2B_API_KEY=
E2B_TEMPLATE=heisenbug-python
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated stable numeric GitHub user IDs. Empty denies admin access.
ADMIN_GITHUB_IDS=
MAX_SANDBOXES=10
WORKSPACE_IDLE_MINUTES=10
WORKSPACE_MAX_MINUTES=60
WORKSPACE_DAILY_MINUTES=120
